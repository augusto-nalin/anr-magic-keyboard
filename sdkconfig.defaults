# Magic Keyboard Config

CONFIG_IDF_TARGET="esp32"

CONFIG_MKB_MEDIA_KEYS=y
CONFIG_MKB_KEYBOARD_POWER_IDLE=y
CONFIG_MKB_KEYBOARD_POLL_SLOTS=6
# CONFIG_MKB_LATENCY_MARKERS is not set
# CONFIG_MKB_DISABLE_OPTIMIZATIONS is not set
CONFIG_MKB_ADDITIONAL_WARNINGS=y
CONFIG_MKB_WARNINGS_AS_ERRORS=y

# Performance build (-O2). For stepping through code in a debugger, switch to
# CONFIG_COMPILER_OPTIMIZATION_DEBUG and CONFIG_MKB_DISABLE_OPTIMIZATIONS in `make config`.
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# Board Config

# 80MHz and the lowest brownout level: the RF calibration when the radio starts browns the board out otherwise
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_80=y
CONFIG_ESP_BROWNOUT_DET_LVL_SEL_0=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="board/partitions.csv"

# Bluetooth
# Bluedroid, NimBLE has no Classic support. Dual mode keeps BLE available for the PC side.
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BTDM=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_HID_ENABLED=y
CONFIG_BT_HID_HOST_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_GATTS_ENABLE=y

# FreeRTOS
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
