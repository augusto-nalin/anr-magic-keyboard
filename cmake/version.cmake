if (ENABLE_VERSION)
    # Make sure to output to a separate folder on each build
    # Builds run concurrently and override each other changes
    file(MAKE_DIRECTORY ${CMAKE_BINARY_DIR}/gen)
    set(VERSION_HEADER ${CMAKE_BINARY_DIR}/gen/version.h)

    string(REPLACE "." ";" VERSION_LIST ${CMAKE_PROJECT_VERSION})
    list(GET VERSION_LIST 0 CMAKE_PROJECT_VERSION_MAJOR)
    list(GET VERSION_LIST 1 CMAKE_PROJECT_VERSION_MINOR)
    list(GET VERSION_LIST 2 CMAKE_PROJECT_VERSION_PATCH)
    list(GET VERSION_LIST 3 CMAKE_PROJECT_VERSION_TWEAK)

    # Re-enable write before regenerating, then strip it so editors/IDE flag
    # the header as read-only (auto-generated; manual edits get lost on rebuild).
    if (EXISTS ${VERSION_HEADER})
        file(CHMOD ${VERSION_HEADER} PERMISSIONS OWNER_READ OWNER_WRITE)
    endif ()

    file(WRITE ${VERSION_HEADER} "// auto-generated by version.cmake\n")
    file(APPEND ${VERSION_HEADER} "#pragma once\n\n")
    file(APPEND ${VERSION_HEADER} "namespace ${CMAKE_PROJECT_NAME}::gen::version {\n")
    file(APPEND ${VERSION_HEADER} "inline constexpr auto major{${CMAKE_PROJECT_VERSION_MAJOR}};\n")
    file(APPEND ${VERSION_HEADER} "inline constexpr auto minor{${CMAKE_PROJECT_VERSION_MINOR}};\n")
    file(APPEND ${VERSION_HEADER} "inline constexpr auto patch{${CMAKE_PROJECT_VERSION_PATCH}};\n")
    file(APPEND ${VERSION_HEADER} "inline constexpr auto build{${CMAKE_PROJECT_VERSION_TWEAK}};\n")
    file(APPEND ${VERSION_HEADER} "inline constexpr auto semantic{\"${CMAKE_PROJECT_VERSION}\"};\n")
    file(APPEND ${VERSION_HEADER} "}\n")

    file(CHMOD ${VERSION_HEADER} PERMISSIONS OWNER_READ GROUP_READ WORLD_READ)
endif ()
